worker_hello: {
  worker_id: "golden-worker-001"
  instance_id: "golden-instance-001"
  runtime_version: "1.0.0"
  protocol_version: {
    min_major: 1
    min_minor: 0
    max_major: 1
    max_minor: 0
  }
  capabilities: {
    kotlin_compiler_available: true
    supported_language_versions: ["KOTLIN_2_0", "KOTLIN_2_4"]
    max_concurrent_steps: 4
    max_heap_mb: 2048
    supports_parallel_frames: true
  }
  system_info: {
    os_name: "linux"
    os_version: "6.8.0"
    os_arch: "amd64"
    cpu_cores: 8
    total_memory_mb: 16384
  }
  execution_capabilities: {
    supports_cancel: true
    supports_kill: true
    supports_checkpoint: true
    supports_script_isolation: true
  }
}

negotiated_session: {
  session_id: "golden-session-001"
  heartbeat_interval_seconds: 30
  max_message_size_bytes: 10485760
  session_policy: {
    max_reconnect_attempts: 5
    reconnect_backoff_max_seconds: 60
    session_timeout_seconds: 3600
    event_buffer_size: 10000
  }
}
